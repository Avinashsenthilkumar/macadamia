# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────
# Pooled connection string (Neon "Pooled connection", host contains -pooler)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/ganesh?sslmode=require"
# Direct (non-pooled) connection string — used by Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/ganesh?sslmode=require"

# ─── Admin authentication ────────────────────────────────────────────────
# Generate with:  openssl rand -base64 32
AUTH_SECRET=""
# Used only by `npm run admin:create` to create the first admin account
ADMIN_EMAIL="care@ganeshnursery.com"

# ─── Email (Resend) — optional; enquiries still save without it ──────────
RESEND_API_KEY=""
# Inbox that receives new-enquiry notifications
CONTACT_EMAIL="care@ganeshnursery.com"
# Verified sender in Resend, e.g. "Ganesh Nursery <noreply@ganeshnursery.co.in>"
EMAIL_FROM=""

# ─── Image uploads (Cloudinary) — required on Vercel ─────────────────────
# Without these, uploads are saved to /public/uploads (local development only)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Public ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://ganeshnursery.co.in"
NEXT_PUBLIC_WHATSAPP_NUMBER="919943119955"
